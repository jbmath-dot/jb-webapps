"전날 익힌 재료를 분량대로 소분·냉장하고 아침에 충분히 재가열하세요."},{"title":"고구마·사과·두부","ingredients":{"sweet":100,"apple":60,"tofu":35},"steps":["미리 찐 고구마와 두부를 충분히 데웁니다.","껍질을 벗겨 작게 자른 사과와 제공합니다."],"mins":7,"prep":"전날 익힌 재료를 분량대로 소분·냉장하고 아침에 충분히 재가열하세요."},{"title":"소고기 밥과 김","ingredients":{"rice":40,"kim":3,"beef":40},"steps":["흰밥과 미리 익힌 소고기를 데웁니다.","소고기를 가늘게 찢어 김과 함께 줍니다."],"mins":7,"prep":"전날 익힌 재료를 분량대로 소분·냉장하고 아침에 충분히 재가열하세요."},{"title":"사과 오트밀죽","ingredients":{"oats":30,"apple":60,"tofu":35},"steps":["오트밀과 잘게 썬 사과를 물에 부드럽게 끓입니다.","두부를 으깨 곁들입니다."],"mins":7,"prep":"전날 익힌 재료를 분량대로 소분·냉장하고 아침에 충분히 재가열하세요."},{"title":"닭고기 바나나 토스트","ingredients":{"toast":40,"banana":65,"chicken":35},"steps":["익혀 둔 닭고기를 데우고 잘게 찢습니다.","빵과 얇게 썬 바나나를 곁들입니다."],"mins":7,"prep":"전날 익힌 재료를 분량대로 소분·냉장하고 아침에 충분히 재가열하세요."}],"L":[{"title":"돼지안심구이와 애호박국","ingredients":{"rice":180,"kim":4,"pork":330,"zucchini":125,"onion":70},"steps":["돼지고기를 얇게 썰어 속까지 익힙니다.","애호박과 양파를 넣고 맑은국을 끓입니다.","첫째 몫을 미리 덜고 성인 국만 간합니다."],"mins":20,"prep":""},{"title":"닭고기 감자맑은탕","ingredients":{"rice":180,"kim":4,"chicken":340,"potato":250,"carrot":90},"steps":["닭다리살을 한입 크기로 썰어 익힙니다.","감자·당근을 부드러워질 때까지 끓입니다.","첫째 고기는 작게 잘라 맑은탕과 줍니다."],"mins":20,"prep":""},{"title":"두부 애호박덮밥(밥 따로)","ingredients":{"rice":180,"kim":4,"tofu":300,"zucchini":125,"onion":80},"steps":["두부를 큼직하게 잘라 익힙니다.","애호박과 양파를 부드럽게 볶습니다.","첫째는 흰밥과 반찬을 분리해 주세요."],"mins":20,"prep":""},{"title":"돼지고기 감자볶음과 밥","ingredients":{"rice":180,"kim":4,"pork":320,"potato":200,"onion":70},"steps":["돼지고기를 먼저 완전히 익힙니다.","얇게 썬 감자와 양파를 넣고 볶습니다.","첫째 몫을 덜고 어른 것만 간합니다."],"mins":20,"prep":""},{"title":"닭고기 당근죽과 밥","ingredients":{"rice":160,"chicken":310,"carrot":120,"onion":80},"steps":["닭고기와 당근을 잘게 썰어 익힙니다.","밥과 물을 넣고 부드러운 죽을 끓입니다.","어른 몫에 기호에 맞게 간합니다."],"mins":20,"prep":""},{"title":"소고기 양파찜과 밥","ingredients":{"rice":180,"kim":4,"beef":280,"onion":120,"broccoli":80},"steps":["얇게 썬 소고기와 양파를 팬에 익힙니다.","브로콜리를 충분히 찝니다.","첫째 몫을 부드럽게 잘라 제공합니다."],"mins":20,"prep":""},{"title":"두부 당근국과 밥","ingredients":{"rice":180,"kim":4,"tofu":300,"carrot":100,"potato":150},"steps":["당근·감자를 작게 썰어 국을 끓입니다.","두부를 넣고 한 번 더 끓입니다.","아이 몫은 간하지 않고 먼저 덜어줍니다."],"mins":20,"prep":""}],"D":[{"title":"닭다리살구이와 감자국","ingredients":{"rice":180,"kim":4,"chicken":360,"potato":180,"onion":70},"steps":["닭고기를 펼쳐 속까지 충분히 굽습니다.","감자와 양파를 넣어 맑은국을 끓입니다.","첫째 몫을 작게 잘라 덜고 성인 것만 간합니다."],"mins":20,"prep":""},{"title":"돼지안심과 브로콜리찜","ingredients":{"rice":180,"kim":4,"pork":360,"broccoli":150},"steps":["안심을 얇게 썰어 물을 조금 넣고 촉촉하게 익힙니다.","브로콜리를 부드럽게 찝니다.","아이 몫을 따로 담고 어른용에만 양념을 합니다."],"mins":20,"prep":""},{"title":"소고기 양파볶음과 감자국","ingredients":{"rice":180,"kim":4,"beef":320,"onion":110,"potato":150},"steps":["소고기와 양파를 볶습니다.","감자로 맑은국을 끓입니다.","첫째 몫을 덜어내고 성인용만 간장으로 간합니다."],"mins":20,"prep":""},{"title":"돼지고기 당근조림","ingredients":{"rice":180,"kim":4,"pork":350,"carrot":120,"onion":60},"steps":["돼지고기와 당근을 작은 크기로 준비합니다.","물을 조금 넣어 속까지 충분히 조립니다.","첫째 몫을 덜고 남은 어른용에 간장을 넣습니다."],"mins":20,"prep":""},{"title":"닭고기 감자조림","ingredients":{"rice":180,"kim":4,"chicken":360,"potato":200,"onion":60},"steps":["닭고기를 완전히 익힙니다.","감자와 양파를 넣고 물로 촉촉하게 조립니다.","아이 몫을 먼저 덜고 어른용만 간합니다."],"mins":20,"prep":""},{"title":"돼지고기 애호박볶음","ingredients":{"rice":180,"kim":4,"pork":330,"zucchini":125,"onion":80},"steps":["돼지고기를 얇게 썰어 굽습니다.","애호박과 양파를 넣고 부드럽게 볶습니다.","첫째 몫은 싱겁게 잘라 제공합니다."],"mins":20,"prep":""},{"title":"닭고기 두부맑은국","ingredients":{"rice":180,"kim":4,"chicken":330,"tofu":200,"onion":60},"steps":["닭고기를 속까지 완전히 익힙니다.","두부와 양파를 넣고 맑은국을 끓입니다.","아이 몫을 먼저 덜고 성인용에 간합니다."],"mins":20,"prep":""}]},"B":{"desc":"소·돼지·닭·생선·두부와 여러 채소를 고르게 활용","theme":"영양균형","B":[{"title":"소고기 밥·김과 과일","ingredients":{"rice":40,"kim":3,"beef":35,"apple":60},"steps":["밥과 익혀 둔 소고기를 데웁니다.","김과 작게 썬 과일을 곁들입니다."],"mins":7,"prep":"전날 익힌 재료를 분량대로 소분·냉장하고 아침에 충분히 재가열하세요."},{"title":"귀리 바나나 두부죽","ingredients":{"oats":30,"banana":65,"tofu":40},"steps":["오트밀을 물에 부드럽게 끓입니다.","바나나를 으깨고 두부를 곁들입니다."],"mins":7,"prep":"전날 익힌 재료를 분량대로 소분·냉장하고 아침에 충분히 재가열하세요."},{"title":"두부 토스트와 사과","ingredients":{"toast":